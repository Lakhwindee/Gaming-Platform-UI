{
  "expo": {
    "name": "Blaze",
    "slug": "gaming-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gaming-platform",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080005"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stargames.blaze",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp", "upi", "bhim"]
      }
    },
    "android": {
      "backgroundColor": "#080005",
      "package": "com.stargames.blaze"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "company": "Star Games",
      "appDescription": "Blaze — Premium Crash Game by Star Games"
    }
  }
}
